{
  "name": "puppeteer-termux",
  "version": "1.5.0",
  "description": "Puppeteer with full Termux support. Bypasses bot detection (Cloudflare, etc.), auto-detects Chromium on Termux, and uses xvfb-run for headful mode on Android.",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.mjs",
  "exports": {
    ".": {
      "require": "./lib/cjs/index.js",
      "import": "./lib/esm/index.mjs",
      "types": "./typings.d.ts"
    }
  },
  "typings": "typings.d.ts",
  "scripts": {
    "esm_test": "node ./test/esm/test.js",
    "cjs_test": "node ./test/cjs/test.js"
  },
  "keywords": [
    "puppeteer-termux",
    "termux-puppeteer",
    "termux-chromium",
    "termux-browser",
    "cf-bypass",
    "cloudflare-bypass",
    "puppeteer-fingerprint",
    "puppeteer-cloudflare",
    "puppeteer-real-browser",
    "undetectable-puppeteer",
    "undetect",
    "undetectable",
    "puppeteer-undetectable",
    "puppeteer-undetect",
    "puppeteer-undetectable-bypass",
    "puppeteer-undetect-bypass",
    "puppeteer-undetectable-cloudflare",
    "puppeteer-undetect-cloudflare",
    "puppeteer-undetectable-cf",
    "puppeteer-undetect-cf",
    "puppeteer-undetectable-cf-bypass"
  ],
  "author": "zfc-software",
  "license": "ISC",
  "dependencies": {
    "chrome-launcher": "^1.1.2",
    "ghost-cursor": "^1.3.0",
    "puppeteer-extra": "^3.3.6",
    "rebrowser-puppeteer-core": "^23.3.1",
    "tree-kill": "^1.2.2",
    "xvfb": "^0.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zfcsoftware/puppeteer-termux"
  },
  "readme": "README.md",
  "homepage": "https://github.com/zfcsoftware/puppeteer-termux"
}
